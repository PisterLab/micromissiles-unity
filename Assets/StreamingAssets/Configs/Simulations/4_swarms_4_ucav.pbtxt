end_time: 300
time_scale: 1
asset_configs {
  config_file: "cvn.pbtxt"
  initial_state {
    position {
      x: 0
      y: 0
      z: 0
    }
    velocity {
      x: 0
      y: 0
      z: 0
    }
  }
  dynamic_config {
    guidance_config {
      controller_type: STATIC
    }
    sensor_config {
      type: IDEAL
      frequency: 1000
    }
  }
}
interceptor_swarm_configs {
  agent_config {
    config_file: "ddg.pbtxt"
    initial_state {
      position {
        x: 0
        y: 0
        z: 0
      }
      velocity {
        x: 5
        y: 0
        z: 0
      }
    }
    dynamic_config {
      guidance_config {
        controller_type: STATIC
      }
      sensor_config {
        type: IDEAL
        frequency: 1000
      }
    }
    sub_agent_config {
      num_sub_agents: 126
      agent_config {
        config_file: "hydra70.pbtxt"
        dynamic_config {
          guidance_config {
            controller_type: PROPORTIONAL_NAVIGATION
          }
          sensor_config {
            type: IDEAL
            frequency: 100
          }
        }
        sub_agent_config {
          num_sub_agents: 7
          agent_config {
            config_file: "micromissile.pbtxt"
            dynamic_config {
              guidance_config {
                controller_type: PROPORTIONAL_NAVIGATION
              }
              sensor_config {
                type: IDEAL
                frequency: 100
              }
            }
          }
        }
      }
    }
  }
}
threat_swarm_configs {
  num_agents: 1
  agent_config {
    config_file: "ucav.pbtxt"
    attack_behavior_config_file: "default_direct_attack.pbtxt"
    initial_state {
      position {
        x: 0
        y: 800
        z: 7000
      }
      velocity {
        x: 0
        y: 0
        z: -50
      }
    }
    standard_deviation {
      position {
        x: 0
        y: 0
        z: 0
      }
      velocity {
        x: 0
        y: 0
        z: 0
      }
    }
    dynamic_config {
      guidance_config {
        evasion_config {
          enabled: true
          range_threshold: 1000
        }
      }
      sensor_config {
        type: IDEAL
        frequency: 100
      }
    }
  }
}

